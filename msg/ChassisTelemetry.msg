uint8 MODE_AUTO=2

uint8 FSM_NORMAL=0
uint8 FSM_RAMP_DOWN=1
uint8 FSM_LOCKED=2

uint8 SOURCE_NONE=0
uint8 SOURCE_CMD_VEL=1
uint8 SOURCE_WHEEL_COMMAND=2
uint8 SOURCE_TELEOP=3

uint32 FAULT_FRONT_WHEEL_FEEDBACK_TIMEOUT=1
uint32 FAULT_REAR_WHEEL_FEEDBACK_TIMEOUT=2
